# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/packages/*/dist/

# scripts/gen-registries.mjs が作る一覧
*.generated.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
# copied from node_modules at build time (scripts/copy-maplibre-worker.mjs)
/public/maplibre/

# playwright
/test-results/
/playwright-report/

# content/news/*.md から scripts/build-news.mjs が作る
/src/lib/news.generated.json

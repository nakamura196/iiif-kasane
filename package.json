{
  "name": "iiif-kasane",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen": "node scripts/gen-registries.mjs",
    "news": "node scripts/build-news.mjs",
    "predev": "node scripts/build-news.mjs",
    "prebuild": "node scripts/build-news.mjs",
    "pretest": "node scripts/build-news.mjs",
    "prelint": "node scripts/build-news.mjs",
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev -p 3838",
    "build:element": "npm run build:element -w @nakamura196/iiif-viewer",
    "build": "node scripts/copy-maplibre-worker.mjs && npm run build:element && next build && node scripts/copy-element.mjs",
    "start": "next start -p 3838",
    "lint": "eslint .",
    "test": "vitest run",
    "test:basepath": "GITHUB_PAGES=true npm run build && ./scripts/check-basepath.sh",
    "test:export": "node scripts/check-export.mjs",
    "test:live": "node scripts/check-live.mjs",
    "test:e2e": "playwright test",
    "auth-mock": "node scripts/auth-mock-server.mjs"
  },
  "dependencies": {
    "@iiif/presentation-3": "^2.2.4",
    "@nakamura196/iiif-viewer": "*",
    "@nakamura196/react-ui": "github:nakamura196/react-ui#v0.5.0",
    "@next/third-parties": "^16.4.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "gsap": "^3.15.0",
    "jotai": "^2.12.5",
    "maplibre-gl": "6.13.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "openseadragon": "6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6"
  }
}

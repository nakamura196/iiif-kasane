        }
       ]
      },
      {
       "id": "https://kasane.ldas.jp/manifests/si-triceratops.json/scene/1/annotations/tqjzgacSelwY",
       "type": "Annotation",
       "motivation": [
        "commenting"
       ],
       "label": {
        "en": [
         "Skull"
        ]
       },
       "body": {
        "type": "TextualBody",
        "value": "As with most horned dinosaurs, the skull is large (7 feet long) compared to the body. It sat on a short neck and was held low to the ground, indicating Triceratops probably fed on low-growing plants.",
        "format": "text/plain",
        "language": "en"
       },
       "target": {
        "type": "SpecificResource",
        "source": {
         "id": "https://kasane.ldas.jp/manifests/si-triceratops.json/scene/1",
         "type": "Scene"

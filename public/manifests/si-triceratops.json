     "items": [
      {
       "id": "https://kasane.ldas.jp/manifests/si-triceratops.json/scene/1/annotations/ll064WOo8byC",
       "type": "Annotation",
       "motivation": [
        "commenting"
       ],
       "label": {
        "en": [
         "About the Skeleton"
        ]
       },
       "body": {
        "type": "TextualBody",
        "value": "This is a composite specimen, assembled from the remains of several Triceratops individuals. The bones are casts made from real bones and 3D prints. The skeleton is 21 feet long and 8.5 feet tall.",
        "format": "text/plain",
        "language": "en"
       },
       "target": {
